# Copy to .env and fill in.
# The web address for this agency. Point its DNS A record at the server first.
DOMAIN=desk.example.in
# Optional: pick the one-time setup code yourself. If empty, one is printed in the logs on first start.
SETUP_CODE=
# Time zone used for "today", follow-up dates and trip status.
TZ_AGENCY=Asia/Kolkata
# How many daily backups to keep in data/backups.
BACKUP_KEEP=14
